<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_qa_bug_ticket_form" model="ir.ui.view">
        <field name="name">qa.bug.ticket.form</field>
        <field name="model">qa.bug.ticket</field>
        <field name="arch" type="xml">
            <form string="Bug Ticket">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,triaged,in_progress,fixed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <label for="title"/>
                        <h2>
                            <field name="title" placeholder="Bug title..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="severity"/>
                            <field name="source"/>
                            <field name="reporter"/>
                            <field name="assignee_id"/>
                        </group>
                        <group>
                            <field name="ci_branch"/>
                            <field name="ci_commit_sha"/>
                            <field name="component_a_bug_id"/>
                            <field name="resolved_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Evidence" name="evidence">
                            <field name="evidence_ids">
                                <list editable="bottom">
                                    <field name="kind"/>
                                    <field name="url" widget="url"/>
                                    <field name="caption"/>
                                </list>
                            </field>
                        </page>
                        <page string="CI Info" name="ci_info">
                            <group>
                                <field name="ci_run_url" widget="url"/>
                                <field name="report_share_url" widget="url"/>
                            </group>
                            <div class="o_row mt-2">
                                <button string="Open CI Run" type="object"
                                        name="action_open_ci_run"
                                        invisible="not ci_run_url"
                                        class="btn btn-secondary"/>
                                <button string="Open Report" type="object"
                                        name="action_open_report"
                                        invisible="not report_share_url"
                                        class="btn btn-secondary ms-2"/>
                            </div>
                        </page>
                        <page string="Chatter" name="chatter">
                            <div class="oe_chatter">
                                <field name="message_follower_ids"/>
                                <field name="activity_ids"/>
                                <field name="message_ids"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_qa_bug_ticket_list" model="ir.ui.view">
        <field name="name">qa.bug.ticket.list</field>
        <field name="model">qa.bug.ticket</field>
        <field name="arch" type="xml">
            <list string="Bug Tickets" decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'high'"
                  decoration-muted="status in ('fixed', 'wont_fix', 'duplicate')">
                <field name="name"/>
                <field name="title"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'high'"
                       decoration-info="severity == 'medium'"
                       decoration-success="severity == 'low'"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'fixed'"
                       decoration-danger="status == 'new'"
                       decoration-info="status == 'in_progress'"/>
                <field name="ci_branch"/>
                <field name="assignee_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_qa_bug_ticket_kanban" model="ir.ui.view">
        <field name="name">qa.bug.ticket.kanban</field>
        <field name="model">qa.bug.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="title"/>
                <field name="severity"/>
                <field name="status"/>
                <field name="assignee_id"/>
                <field name="ci_branch"/>
                <progressbar field="severity"
                             colors='{"critical": "danger", "high": "warning", "medium": "info", "low": "success"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="title"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <span t-attf-class="badge rounded-pill
                                        #{record.severity.raw_value == 'critical' ? 'text-bg-danger' :
                                          record.severity.raw_value == 'high' ? 'text-bg-warning' :
                                          record.severity.raw_value == 'medium' ? 'text-bg-info' : 'text-bg-success'}">
                                        <field name="severity"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="text-muted">
                                    <field name="name"/>
                                </span>
                                <t t-if="record.ci_branch.raw_value">
                                    <span class="ms-2 badge text-bg-secondary">
                                        <field name="ci_branch"/>
                                    </span>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"/>
                                <div class="oe_kanban_bottom_right">
                                    <field name="assignee_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_qa_bug_ticket_search" model="ir.ui.view">
        <field name="name">qa.bug.ticket.search</field>
        <field name="model">qa.bug.ticket</field>
        <field name="arch" type="xml">
            <search string="Search Bug Tickets">
                <field name="title"/>
                <field name="name"/>
                <field name="ci_branch"/>
                <field name="assignee_id"/>
                <separator/>
                <filter string="New" name="filter_new" domain="[('status', '=', 'new')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('status', '=', 'in_progress')]"/>
                <filter string="Fixed" name="filter_fixed"
                        domain="[('status', '=', 'fixed')]"/>
                <separator/>
                <filter string="Critical" name="filter_critical"
                        domain="[('severity', '=', 'critical')]"/>
                <filter string="High" name="filter_high"
                        domain="[('severity', '=', 'high')]"/>
                <filter string="Medium" name="filter_medium"
                        domain="[('severity', '=', 'medium')]"/>
                <filter string="Low" name="filter_low"
                        domain="[('severity', '=', 'low')]"/>
                <separator/>
                <filter string="From CI" name="filter_ci"
                        domain="[('source', '=', 'ci')]"/>
                <filter string="From Report" name="filter_report"
                        domain="[('source', '=', 'report_link')]"/>
                <filter string="Manual" name="filter_manual"
                        domain="[('source', '=', 'manual')]"/>
                <separator/>
                <filter string="My Tickets" name="filter_my"
                        domain="[('assignee_id', '=', uid)]"/>
                <filter string="Unassigned" name="filter_unassigned"
                        domain="[('assignee_id', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Severity" name="group_severity"
                            context="{'group_by': 'severity'}"/>
                    <filter string="Branch" name="group_branch"
                            context="{'group_by': 'ci_branch'}"/>
                    <filter string="Source" name="group_source"
                            context="{'group_by': 'source'}"/>
                    <filter string="Assignee" name="group_assignee"
                            context="{'group_by': 'assignee_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
