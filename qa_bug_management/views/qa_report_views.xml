<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qa_report_list" model="ir.ui.view">
        <field name="name">qa.report.list</field>
        <field name="model">qa.report</field>
        <field name="arch" type="xml">
            <list string="QA Reports" default_order="create_date desc">
                <field name="name"/>
                <field name="project_name"/>
                <field name="report_date"/>
                <field name="bug_count"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_qa_report_form" model="ir.ui.view">
        <field name="name">qa.report.form</field>
        <field name="model">qa.report</field>
        <field name="arch" type="xml">
            <form string="QA Report">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_name"/>
                            <field name="report_date"/>
                            <field name="bug_count"/>
                        </group>
                        <group>
                            <field name="share_token"/>
                            <field name="share_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bug Tickets" name="bugs">
                            <field name="bug_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="priority" widget="badge"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qa_report" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">qa.report</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
