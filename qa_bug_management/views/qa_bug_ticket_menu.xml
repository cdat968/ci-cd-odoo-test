<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_qa_bug_ticket" model="ir.actions.act_window">
        <field name="name">Bug Tickets</field>
        <field name="res_model">qa.bug.ticket</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_qa_bug_ticket_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bug tickets found.
            </p>
            <p>
                Create a bug ticket manually or wait for the CI pipeline to report failures.
            </p>
        </field>
    </record>

    <menuitem id="menu_qa_root"
              name="QA"
              sequence="90"/>

    <menuitem id="menu_qa_bugs"
              name="Bug Tickets"
              parent="menu_qa_root"
              action="action_qa_bug_ticket"
              sequence="10"/>

</odoo>
