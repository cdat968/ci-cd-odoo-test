<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_ticket_view_form_qa_bridge" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.qa.bridge</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="qa_bug_id" invisible="1"/>
                <button string="Create QA Bug"
                        name="action_create_qa_bug"
                        type="object"
                        invisible="qa_bug_id"
                        groups="qa_bug_management.group_qa_manager"/>
                <button string="Open QA Bug"
                        name="action_open_qa_bug"
                        type="object"
                        invisible="not qa_bug_id"
                        groups="qa_bug_management.group_qa_user,qa_bug_management.group_qa_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_qa_bug"
                        icon="fa-bug"
                        invisible="not qa_bug_id"
                        groups="qa_bug_management.group_qa_user,qa_bug_management.group_qa_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_text">QA Bug</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
