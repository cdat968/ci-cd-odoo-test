<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_project_view_form_qa_bugs" model="ir.ui.view">
        <field name="name">project.project.form.qa.bugs</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_qa_bugs"
                        icon="fa-bug"
                        invisible="qa_bug_count == 0"
                        groups="qa_bug_management.group_qa_user,qa_bug_management.group_qa_manager">
                    <field name="qa_bug_count" string="Bugs" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//notebook/page[@name='settings']" position="before">
                <page name="qa_bugs"
                      string="Bugs"
                      invisible="qa_bug_count == 0"
                      groups="qa_bug_management.group_qa_user,qa_bug_management.group_qa_manager">
                    <group>
                        <group string="Bug Summary">
                            <field name="qa_bug_count" readonly="1"/>
                            <field name="open_qa_bug_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="qa_bug_ids" readonly="1" nolabel="1">
                        <list string="Project Bugs">
                            <field name="name"/>
                            <field name="title"/>
                            <field name="severity" widget="badge"/>
                            <field name="priority" widget="badge"/>
                            <field name="status" widget="badge"/>
                            <field name="assignee_id" widget="many2one_avatar_user"/>
                            <field name="source"/>
                            <field name="helpdesk_ticket_id"/>
                            <field name="project_task_id"/>
                            <field name="create_date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
